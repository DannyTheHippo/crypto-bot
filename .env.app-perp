# Perp lane deploy knobs (docker compose `app-perp` service, --profile perp).
# Secrets live in gitignored .env only — compose loads env_file: [.env.app-perp, .env].


# ── Server ──
PORT=3100
LOG_LEVEL=debug # fatal|error|warn|info|debug|trace
NODE_ENV=production # MUST NOT be test/ci (those force paper + skip the runtime)
HOST=0.0.0.0

# ── Mode ──
TRADING_MODE=testnet
SANDBOX_ENV=demo
FEED_ENV=live
# This IS the futures-demo lane the spot app's VENUES comment describes: binanceusdm/demo,
# probe-verified to authenticate against demo-fapi.binance.com with the SAME BINANCE_DEMO_*
# keys the spot app uses (env_file below covers both).
VENUES=[{"id":"binanceusdm","environment":"demo"}]

# Demo Trading keys (used when SANDBOX_ENV=demo). Withdrawals must be disabled. Same keys
# as the spot `app` service — provided via env_file above, not repeated here.

# Live keys — read ONLY when TRADING_MODE=live (stripped under NODE_ENV=test/ci).

# ── Strategy (agentic LLM lane) ──
ACTIVE_STRATEGY=agentic
# Single perp market, settle-suffixed ccxt symbol id — required exact form for a
# binanceusdm venue (domain/risk/default-filters.ts already carries a BTC/USDT:USDT row).
TRADING_SYMBOLS=BTC/USDT:USDT,ETH/USDT:USDT,SOL/USDT:USDT,ZEC/USDT:USDT,AAVE/USDT:USDT,NEAR/USDT:USDT,HYPE/USDT:USDT,KAITO/USDT:USDT # X2 stage-1 2026-07-20: 8 crypto-native USDT-M perps, universe-study ranked (mean-abs-ret x log 30d volume, $0.50 floor), all demo-probe-verified TRADING; equity-tokenized perps excluded (trading-hour gaps fight bar scheduling/staleness); stage 2 (16/menu-6) only after one clean 24h soak inside ceilings
# Universe (U1/I2): single-symbol lane — the active menu is the whole (1-symbol) basket.
# AGENTIC_ACTIVE_MENU_SIZE (schema default 12) MUST be pinned to 1 here or the
# AGENTIC_ACTIVE_MENU_SIZE superRefine in environment.config.ts (menu <= basket size) refuses boot.
AGENTIC_ACTIVE_MENU_SIZE=4 # X2 stage-1 2026-07-20: menu-4 on the 8-basket; 6 at stage-2
STRATEGY_INTERVAL=15m # candle interval the agent decides on; one symbol only here, far under AGENTIC_MAX_CALLS_PER_DAY
AGENTIC_MODEL=claude-sonnet-5
AGENTIC_REFLECTION_MODEL=claude-opus-4-8
AGENTIC_TIMEOUT_MS=30000
AGENTIC_REFLECTION_TIMEOUT_MS=240000
AGENTIC_MAX_TOKENS=4096 # max output tokens per LLM call (1024→4096, v2 decision contract 2026-07-18: richer per-consult output — directives, thesis, portfolio scheduling — needs headroom)
AGENTIC_MIN_DECISION_INTERVAL_MS=0
AGENTIC_WARMUP_BARS=340
AGENTIC_MAX_CALLS_PER_DAY=1100 # 700→1100 (v2 decision contract 2026-07-18): matches the spot lane's cap; single-symbol call volume is far under either ceiling, the $/day breaker stays the true governor
AGENTIC_MAX_TOKENS_PER_DAY=2000000
AGENTIC_DAILY_COST_STOP_USD=1.50 # X2 2026-07-20: menu-4 batch payloads (was 0.75 single-symbol; A0/X2 spec raises with the widened menu)
AGENTIC_MAX_ENTRIES_PER_DAY=40 # runaway sanity cap on entries per UTC day (12→40, v2 decision contract 2026-07-18: entry cadence is model-owned via sizing/scale-in/scheduling now, this is a safety ceiling, not a target)
AGENTIC_ENTRY_TTL_BARS=2
# v2 decision contract (D1/B2, Design § Sizing flow / § New tool contract): per-lane conviction-channel
# cap on sizeFraction — perp is single-symbol, sized wider than spot's 24-symbol-basket 0.15 or 85%
# of the book would be permanently stranded.
AGENTIC_MAX_POSITION_FRACTION=0.35 # X2 2026-07-20: multi-position book (0.50 was single-symbol); RISK gross/net 1200 is the binding portfolio cap
# v2 consult scheduler (B2, replaces the deleted prescreen gate): floor re-consult cadence even if
# the model's own nextConsultBars requested a longer gap or the schedule stalls.
AGENTIC_FALLBACK_CONSULT_BARS=8 # XA1 2026-07-20: 16 (4h) starved evidence pace — 2h floor
# v2 consult scheduler (B2): wake-on-move — a bar close whose move vs lastConsultPrice clears this
# fraction forces an immediate re-consult regardless of schedule.
AGENTIC_WAKE_MOVE_PCT=0.008 # XA1 2026-07-20: 1.5% never fires in the dominant sub-0.5% chop regime
AGENTIC_PLAN_EXIT_TTL_BARS=2
AGENTIC_DRAIN_COOLDOWN_BASE_MS=30000
AGENTIC_DRAIN_COOLDOWN_MAX_MS=900000
AGENTIC_REFLECTION_EVERY_N_TRADES=2
AGENTIC_REFLECTION_COOLDOWN_MS=21600000
AGENTIC_AUTO_PROMOTE_MIN_TRADES=0
AGENTIC_AUTO_PROMOTE_MIN_ATTRIBUTED_TRADES=10
AGENTIC_PROMOTE_MIN_POS=0.70
AGENTIC_CANDIDATE_LAPSE_HOURS=168
AGENTIC_MINT_FLOOR_ROWS=12
AGENTIC_MINT_FLOOR_MIN_ROWS=6
AGENTIC_MINT_FLOOR_MIN_ENTRIES=1
AGENTIC_ABSTAIN_LAPSE_DECIDES=15
AGENTIC_MINT_BACKTEST_ROWS=60
AGENTIC_MINT_BACKTEST_MARGIN_BPS=10
AGENTIC_MINT_BACKTEST_MIN_TRIPS=3
AGENTIC_PLAN_MODE=true # W3.1 plan-based trading — required for perp: shorts and venue-resting TP both depend on plan mode
# S1 (shorts) ENABLED 2026-07-18 (v2 decision contract, owner round 6, Context: "perp gets leverage
# to a 2x cap" superseded the earlier "shorts at 1x" pick): the L0 longs-only tier this lane booted
# at is retired — TRADE_SHORTS_TOOL/TRADE_PORTFOLIO_SHORTS_TOOL now serve open_short.
AGENTIC_SHORTS_ENABLED=true
# AGENTIC_MIN_EDGE_MULTIPLE / AGENTIC_MIN_RR retired 2026-07-18 (v2 cutover): only the fee floor (TP >= round-trip fees) survives.
# AGENTIC_PLAN_MAX_QUIET_BARS retired 2026-07-18 (v2 cutover): superseded by consult schedule + fallback + wake-on-move.
AGENTIC_QUIET_PAYLOAD_SAMPLE_BARS=4
AGENTIC_VENUE_TP=true # venue-resting take-profit for plan-mode longs
AGENTIC_VENUE_TP_REPLACE_DRIFT_BPS=10
# Push 3 P8d (L0 ENABLE): venue-resting protective STOP_MARKET on the binanceusdm algo rail —
# the reviewed (P7d + P7e/P7f OMS-containment) primary intra-bar protection. Perp margin runs
# TP+STOP together with no base-lock conflict, so the P7f spot boot-refusal does not apply here
# (all venues swap). Rollback = comment out (schema default false, byte-identical). This is the
# FIRST live exercise of the algo-rail lifecycle anywhere — see the perp WATCH lines in
# reports/loop/state.md.
AGENTIC_VENUE_STOP=true
AGENTIC_VENUE_STOP_REPLACE_DRIFT_BPS=10
AGENTIC_PLAYBOOK_AB_PCT=25
# AGENTIC_EXPECTANCY_LADDER retired 2026-07-18 (v2 cutover): ladder deleted; TRACK_RECORD_* internals remain (no env knob).
# AGENTIC_PRESCREEN_* retired 2026-07-18 (v2 cutover): replaced by consult schedule + AGENTIC_FALLBACK_CONSULT_BARS + AGENTIC_WAKE_MOVE_PCT.
AGENTIC_PLAYBOOK_PIN=
AGENTIC_TOKEN_PRICE_INPUT_PER_MTOK=3
AGENTIC_TOKEN_PRICE_OUTPUT_PER_MTOK=15
AGENTIC_TOKEN_PRICE_CACHE_READ_PER_MTOK=0.3
AGENTIC_TOKEN_PRICE_CACHE_WRITE_PER_MTOK=6
AGENTIC_TOKEN_PRICES_JSON={"claude-sonnet-5":{"inputPerMtok":"3","outputPerMtok":"15","cacheReadPerMtok":"0.3","cacheWritePerMtok":"6"},"claude-opus-4-8":{"inputPerMtok":"5","outputPerMtok":"25","cacheReadPerMtok":"0.5","cacheWritePerMtok":"10"}}
# PROMOTION_EVIDENCE_EPOCH: set at the v2 cutover (see the assignment at end of file) — the local
# prod-like soak 2026-07-18 IS the contract cutover; the perp lane was verified FLAT at the epoch
# instant. Pre-epoch history belongs to the retired v1 contract. Not re-reset at the GCP migration.
PROMOTION_DUST_NOTIONAL=5
SIGNAL_TTL_MS=120000
BASE_NOTIONAL=100
SIZER_EQUITY_FRACTION=0.05
# $1k effective book (v2 decision contract, Design § Live-scale economics, 2026-07-18): sizing
# equity = min(actualEquity, SIZER_EQUITY_CAP) on every sizing path.
SIZER_EQUITY_CAP=1000
PROTECT_STOP_LOSS_PCT=0.06 # bot-side backstop: force-exits via the normal risk path if price falls 6% below entry (0.02→0.06, v2 decision contract 2026-07-18, Design § Conflict resolutions: must sit strictly above the model's own stop-loss upper bound 0.05)
PROTECT_TRAILING_PCT=0 # bot-side trailing backstop DISABLED (0.015→0, v2 decision contract 2026-07-18: the model owns trailing via revisable stop directives now)
PLAN_STOP_WATCH_ENABLED=false # L0 boots watcher-off like spot; flip is a P8d/ladder decision
PLAN_STOP_FORCE_BPS=30
EXIT_CROSS_BUFFER_BPS=25
ENTRY_ORDER_TYPE=LIMIT_MAKER
STARTING_CASH=5000

# ── Info-context feeds (kept as the spot app has them; positioning/derivatives poll fapi
# regardless of venue, so they are already perp-native) ──
DERIVATIVES_FEED_ENABLED=true
DERIVATIVES_FEED_POLL_MS=60000
# P5b: perp funding-payment settlement ingestion (funding-ingest.service.ts) — see .env.app's
# own comment for the full rationale; perp lane is where funding_payments actually populates.
FUNDING_INGEST_ENABLED=true
FUNDING_INGEST_POLL_MS=3600000
# Info-context A/B disabled here (0, vs the spot lane's 30): this is a separate, isolated
# evidence lane, not a participant in the spot lane's derivatives/cross-symbol measurement —
# every decide sees the full info bundle, no control-arm split.
AGENTIC_DERIVATIVES_AB_PCT=0
# AGENTIC_THINKING_AB_PCT retired 2026-07-18 (v2 cutover): thinking always on (adaptive) for decide.
AGENTIC_CROSS_SYMBOL_ENABLED=true
AGENTIC_CROSS_SYMBOL_LOOKBACK_BARS=20

# Single-symbol lane: no concurrent same-bar-close propose() calls to batch, so portfolio
# consult is off (vs the spot 5-symbol lane's 'true').
AGENTIC_PORTFOLIO_CONSULT=true # X2 2026-07-20: batched menu consults on the widened basket (rollback = false, legacy per-symbol chain)
AGENTIC_PORTFOLIO_WINDOW_MS=15000 # X2 2026-07-20: mirrors XA1 spot finding — 3s fragments the menu wave; 15s + menu-sized early-flush coalesces

# I2 (2026-07-18): stays OFF, same rationale as the spot lane — no live CryptoPanic auth_token is
# held; follow-up flagged for F2/state.md.
SENTIMENT_FEED_ENABLED=false
FEAR_GREED_FEED_ENABLED=true # X3 2026-07-20: lane-wide alternative.me index, keyless, fail-open (6h poll default); modulator-not-veto per XA3
SENTIMENT_FEED_POLL_MS=300000

AGENTIC_TRADEFLOW_ENABLED=true
AGENTIC_TRADEFLOW_POLL_MS=60000

AGENTIC_POSITIONING_ENABLED=true
AGENTIC_POSITIONING_POLL_MS=300000

# #43 (Push 3 P6 Unit 2): public liquidation-order flow via ccxt PRO's watchLiquidationsForSymbols
# WS stream on binanceusdm. ENABLED 2026-07-18 (v2 decision contract, Design § Enriched model
# inputs: "Feeds on — liquidations + bookStructure + trackRecord").
AGENTIC_LIQUIDATIONS_ENABLED=true
# Book-structure block (Push 3 P6 Unit 3): microprice offset, depth-weighted imbalance, ±25bps
# depth notional. ENABLED 2026-07-18 (v2 decision contract, Design § Enriched model inputs).
AGENTIC_BOOK_STRUCTURE_ENABLED=true
# Track-record block (Push 3 P6 Unit 4): this strategy's own realized tripCount/winRate/
# meanNetBpsPerTrip/trailingWindowTrips, now also net-vs-BTC-hold and net-vs-basket alpha (P4).
# ENABLED 2026-07-18 (v2 decision contract, Design § Enriched model inputs).
AGENTIC_TRACK_RECORD_ENABLED=true

# ── Risk limits (same caps as the spot lane — one account-wide risk posture) ──
RISK_MAX_ORDER_NOTIONAL=500 # quote-notional cap per order (100000→500, v2 decision contract 2026-07-18, Design § Live-scale economics: book-scale envelope for the ~$1k effective book)
RISK_MAX_POSITION_PER_SYMBOL=1000
RISK_MAX_GROSS_EXPOSURE=1200 # portfolio gross exposure cap (quote) (1000000→1200, v2 decision contract 2026-07-18, Design § Live-scale economics: book-scale envelope)
RISK_MAX_NET_EXPOSURE=1200 # portfolio net exposure cap (quote) (1000000→1200, v2 decision contract 2026-07-18, Design § Live-scale economics: book-scale envelope)
RISK_MAX_DAILY_LOSS=5000
RISK_MAX_DRAWDOWN_PCT=0.2
RISK_MAX_BAND_BPS=100
RISK_MAX_PASSIVE_EXIT_BAND_BPS=1200
RISK_STALE_MAX_AGE_MS=5000

# ── Perp/swap paper adapter (B1; PaperPerpAdapter is not wired into app.module.ts yet) ──
# Unrelated to VENUES=binanceusdm above (that path runs through CcxtExchangeAdapter, not this
# scaffold) — kept false/as-is for parity with the spot app's env, byte-identical scaffolding.
PERP_VENUE_ENABLED=false
# Leverage cap (isolated-margin): 1→2 (v2 decision contract 2026-07-18, owner round 6: "perp gets
# leverage to a 2x cap" — existing margin-notional and liq-safe caps with the 20% liquidation
# buffer stay authoritative on top).
PERP_LEVERAGE_CAP=2
PERP_MMR_FALLBACK=0.005
PERP_LIQ_BUFFER_PCT=0.20

# ── Persistence ── own Postgres, same creds pattern, different service DNS name/port
DATABASE_URL=postgres://cryptobot:cryptobot@postgres-perp:5432/cryptobot

# Promotion evidence epoch (v2 cutover, local prod-like soak 2026-07-18): perp lane was verified
# FLAT (no positions, no orders) at this instant. Round trips before this timestamp belong to the
# retired v1 contract and are excluded from promotion evidence. Set per-lane at each lane's own
# flat moment; NOT re-reset at the GCP migration (the DB moves with the stack).
PROMOTION_EVIDENCE_EPOCH=2026-07-20T10:42:00Z # XA7 perp re-stamp 2026-07-20: one-time, immediately after X2 stage-1 deploy (final pre-campaign config: 8-basket/menu-4/0.35/batched consults/seed v5), venue-flat keyed-probe-verified (0 open orders, 0 positions, stale OMS NEW row cbt019f... venue-ABSENT — bookkeeping debt, recorded); prior epoch 2026-07-18T15:36:14Z carried only idle burn, 0 trips. NOT a repeatable ratchet-escape.
