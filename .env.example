# ── Server ──
PORT=3100
LOG_LEVEL=debug                # fatal|error|warn|info|debug|trace
NODE_ENV=production            # MUST NOT be test/ci (those force paper + skip the runtime)
HOST=127.0.0.1                 # bind address (main.ts default; docker-compose sets 0.0.0.0 for the container network)

# ── Mode ──
# paper   = internal simulator, no credentials, no network orders
# testnet = orders placed on a Binance sandbox (SANDBOX_ENV picks which)
# live    = real funds — gated (env flag + bootId-bound arming + key probe + limits); do not use
TRADING_MODE=testnet
# Sandbox flavour when TRADING_MODE=testnet:
#   demo    = Binance Demo Trading (demo-api.binance.com, enableDemoTrading)  -> BINANCE_DEMO_*
#   testnet = Binance Spot Testnet (testnet.binance.vision, setSandboxMode)   -> BINANCE_TESTNET_*
SANDBOX_ENV=demo

# Market-data feed venue/environment. 'live' gives realistic depth for fills; order placement still goes to the SANDBOX_ENV venue above.
FEED_ENV=live
# VENUES='[{"id":"binance","environment":"demo"}]'   # optional; default venue is binance

# ── Credentials ──
# Demo Trading keys (used when SANDBOX_ENV=demo). Withdrawals must be disabled.
BINANCE_DEMO_API_KEY=your-demo-key-here
BINANCE_DEMO_API_SECRET=your-demo-secret-here

# Spot Testnet keys (used when SANDBOX_ENV=testnet)
BINANCE_TESTNET_API_KEY=your-testnet-key-here
BINANCE_TESTNET_API_SECRET=your-testnet-secret-here

# Live keys — read ONLY when TRADING_MODE=live (stripped under NODE_ENV=test/ci). Leave blank for paper/demo.
BINANCE_LIVE_API_KEY=your-live-key-here
BINANCE_LIVE_API_SECRET=your-live-secret-here
# Promoting to live is a deliberate human action behind the four-gate interlock.
ARMING_SECRET=your-arming-secret-here
LIVE_BASE_URL_OVERRIDE=your-live-base-url-override-here

# ── Strategy (agentic LLM lane — the only lane; live access is EARNED, not assumed) ──
# Non-deterministic/step-D-uncertifiable: boot interlock refuses TRADING_MODE=live unless
# PromotionReadinessService returns permitted (see PROMOTION.md). No ANTHROPIC_API_KEY = inert stub.
ACTIVE_STRATEGY=agentic
TRADING_SYMBOL=BTC/USDT        # DEPRECATED single-symbol fallback (used only when TRADING_SYMBOLS is unset)
# Multi-symbol (P7): CSV, one agentic strategy instance per entry (agentic-1, agentic-2, … in CSV
# order — APPEND new symbols, never reorder: positions/journals key off the instance id). Every
# entry must have a DEFAULT_FILTERS row (domain/risk/default-filters.ts) — asserted loud at boot.
# One shared lane-wide LLM budget; entry caps apply per instance. Each symbol ≈ +96 decides/day
# at 15m — five symbols ≈ 480/day opportunities, under AGENTIC_MAX_CALLS_PER_DAY=700 (raised
# 500→700 with the 5-symbol widening; the $/day breaker stays the true governor). Symbol widening
# to SOL/XRP/LINK: owner decision 2026-07-10 (reports/loop/state.md § Strategic frame).
TRADING_SYMBOLS=BTC/USDT,ETH/USDT,SOL/USDT,XRP/USDT,LINK/USDT
STRATEGY_INTERVAL=15m          # candle interval the agent decides on (schema default 5m; compose pins 15m: 5 symbols × 96/day = 480 opportunities under AGENTIC_MAX_CALLS_PER_DAY=700; prescreen keeps true calls far lower)
# Anthropic Messages API key for the agent client (secret — never commit a real key). Setting it
# activates the LIVE agentic lane (it starts proposing decisions on each closed candle); leaving it
# blank binds the inert stub, so the demo boots healthy but never trades until a key is supplied.
ANTHROPIC_API_KEY=
AGENTIC_MODEL=claude-sonnet-5             # Anthropic model id (schema default; matches the AGENTIC_TOKEN_PRICE_* defaults below)
# Reflection-path model override; unset = reflection uses AGENTIC_MODEL. Pinned to the Opus tier
# (owner decision 2026-07-08: reflection is 1-4 calls/day, depth is the point). Per-model pricing
# via AGENTIC_TOKEN_PRICES_JSON keeps the earned-live cost math honest when this differs from
# AGENTIC_MODEL — keep both models present in that map.
AGENTIC_REFLECTION_MODEL=claude-opus-4-8
AGENTIC_TIMEOUT_MS=30000                  # per-call DECIDE request timeout (Sonnet, fast — fail fast)
# Reflection-path timeout, separate from (and much larger than) the decide timeout. Opus + adaptive
# thinking over a large evidence prompt cannot answer in 30s — sharing the decide timeout aborted
# every live reflection attempt (2026-07-09). Off the trading hot path, so a generous value is free.
AGENTIC_REFLECTION_TIMEOUT_MS=240000     # per-call reflection request timeout
AGENTIC_MAX_TOKENS=1024                   # max output tokens per LLM call
AGENTIC_MIN_DECISION_INTERVAL_MS=0        # floor between agent decisions; 0 = every closed candle
AGENTIC_WARMUP_BARS=340                   # closed candles retained; ≥336 keeps h4/h1 HTF indicators non-null at 15m (prompt still slices 50)
AGENTIC_MAX_CALLS_PER_DAY=700             # DailyLlmBudget cap on LLM calls per UTC day (500→700 at the 5-symbol widening)
AGENTIC_MAX_TOKENS_PER_DAY=2000000        # DailyLlmBudget cap on input+output tokens per UTC day
AGENTIC_DAILY_COST_STOP_USD=5             # USD cost circuit breaker per UTC day (tokens x per-model rates, cache included); raised 3->5 with Opus reflection + true cache pricing (owner 2026-07-08); 0 disables
AGENTIC_MAX_ENTRIES_PER_DAY=12            # cap on ENTER_LONG decisions per UTC day
AGENTIC_ENTRY_TTL_BARS=2                  # stale-entry sweep: resting entries older than N observed decide cycles get a CANCEL_OPEN (risk-reducing); 0 disables
AGENTIC_PLAN_EXIT_TTL_BARS=2              # TTL (bars) on plan-executor exit signals; 1-bar TTL races its own age (a max_hold exit expired live 2026-07-07)
AGENTIC_DRAIN_COOLDOWN_BASE_MS=30000      # first AUTO-drain cooldown backoff
AGENTIC_DRAIN_COOLDOWN_MAX_MS=900000      # ceiling on AUTO-drain cooldown backoff
AGENTIC_REFLECTION_EVERY_N_TRADES=2       # closed trades between reflection runs, counted PER STRATEGY (10->5 owner 2026-07-08; 5->2 loop 2026-07-10: 5-symbol widening spread trips across strategies, restoring the calibrated lane cadence); 0 disables
AGENTIC_REFLECTION_COOLDOWN_MS=21600000   # min wall-clock between reflection runs (schema default 7d; demo pins 6h — owner 2026-07-08)
AGENTIC_AUTO_PROMOTE_MIN_TRADES=0         # LEGACY count-only auto-promotion DISABLED (owner 2026-07-08) — replaced by the attributed evaluator below
AGENTIC_AUTO_PROMOTE_MIN_ATTRIBUTED_TRADES=10 # attributed auto-promotion: candidate promotes after ≥N of its OWN A/B-attributed closed trips AND mean net/trip > champion; symmetric since 2026-07-12 (champion needs ≥N too); 0 disables
AGENTIC_PROMOTE_MIN_POS=0.70               # probability-of-superiority floor: promotion also needs Mann–Whitney PoS ≥ this over candidate-vs-champion trip pairs (default 0.70; clamped to [0.5, 1])
AGENTIC_CANDIDATE_LAPSE_HOURS=720          # unresolved-candidate lapse for the reflection mint guard: a stuck candidate stops blocking new mints after this many hours (default 720h = 30d)
AGENTIC_PLAN_MODE=true                     # W3.1 plan-based trading; enabled by owner 2026-07-07 (demo lane; live still behind the unchanged earned-live gate)
AGENTIC_MIN_EDGE_MULTIPLE=1.5              # plan viability floor: reject plans with takeProfitPct < multiple x round-trip fee fraction
AGENTIC_MIN_RR=1.5                         # R:R structure floor: reject plans with takeProfitPct/stopLossPct < ratio (old gate floored only the win side)
AGENTIC_PLAN_MAX_QUIET_BARS=16             # safety re-consult cadence while a plan is active
AGENTIC_QUIET_PAYLOAD_SAMPLE_BARS=4        # snapshot the decide payload every Nth plan-managed bar (offline replay data); 0 disables
AGENTIC_PLAYBOOK_AB_PCT=25                 # W4.1 champion/candidate A/B LIVE (owner 2026-07-08): % of decides routed to the newest INACTIVE reflection candidate; 0 disables
AGENTIC_EXPECTANCY_LADDER=true             # W4.2 reduction-only ENTER_LONG strength ladder ENABLED (owner 2026-07-08); self-releases on recovery
AGENTIC_PRESCREEN_ENABLED=true             # deterministic gate: LLM consulted only on open position / vol expansion / breakout proximity; fail-open
AGENTIC_PRESCREEN_VOL_SHORT_BARS=10        # schema default: short-window bar count for the volatility-expansion check
AGENTIC_PRESCREEN_VOL_LONG_BARS=50         # schema default: long-window bar count for the volatility-expansion check
AGENTIC_PRESCREEN_VOL_RATIO=1.3            # schema default: short/long vol ratio that trips the expansion gate
AGENTIC_PRESCREEN_BREAKOUT_LOOKBACK_BARS=20 # schema default: lookback window for the breakout-proximity check
AGENTIC_PRESCREEN_BREAKOUT_PCT=0.0025       # distance-to-breakout threshold (fraction); tightened 2026-07-07 — breakout drove 73% of calls at 27% skip rate
# Optional playbook_version id to pin; leave unset for latest ACTIVE. (No inline comment after an
# empty assignment — compose env_file would deliver the comment text as the value.)
AGENTIC_PLAYBOOK_PIN=
AGENTIC_TOKEN_PRICE_INPUT_PER_MTOK=3      # default-model (claude-sonnet-5) list price: USD per 1M input tokens
AGENTIC_TOKEN_PRICE_OUTPUT_PER_MTOK=15    # default-model (claude-sonnet-5) list price: USD per 1M output tokens
AGENTIC_TOKEN_PRICE_CACHE_READ_PER_MTOK=0.3 # sonnet-5 cache reads (~0.1x input); was priced $0 — undercounted true spend in the promotion gate
AGENTIC_TOKEN_PRICE_CACHE_WRITE_PER_MTOK=6  # sonnet-5 1h-TTL cache writes (~2x input)
# Per-model price override map (JSON) so a pricier reflection model bills at its own rates; unknown
# models in cost rows price at the most expensive configured rates (fail-closed).
AGENTIC_TOKEN_PRICES_JSON='{"claude-sonnet-5":{"inputPerMtok":"3","outputPerMtok":"15","cacheReadPerMtok":"0.3","cacheWritePerMtok":"6"},"claude-opus-4-8":{"inputPerMtok":"5","outputPerMtok":"25","cacheReadPerMtok":"0.5","cacheWritePerMtok":"10"}}'
# Owner-declared evidence epoch (ISO-8601): promotion gate evaluates from this instant instead of
# all-time; set to the deploy timestamp when shipping a structural change. Empty = all-time. (No
# inline comment after an empty assignment — compose env_file would deliver the comment as the value.)
PROMOTION_EVIDENCE_EPOCH=
PROMOTION_DUST_NOTIONAL=5                 # residual-position notional (quote ccy) below which a round-trip cycle counts as CLOSED
SIGNAL_TTL_MS=120000                      # signal validity window
BASE_NOTIONAL=100                         # quote (USDT) per order; keep below the account balance, above minNotional
SIZER_EQUITY_FRACTION=0.02                # 2% of equity per entry (compounding sizing; overrides BASE_NOTIONAL on entries when > 0; schema default 0 disables; compose pins 0.02). Worst-case gross at 5 symbols ≈ 10% of equity — re-derive before the 0.05 pre-authorization.
PROTECT_STOP_LOSS_PCT=0.02                # bot-side backstop: force-exits a long via the normal risk path if price falls 2% below entry; schema default 0 disables
PROTECT_TRAILING_PCT=0.015                # bot-side backstop: force-exits a long via the normal risk path if price falls 1.5% below its peak since entry; schema default 0 disables
EXIT_CROSS_BUFFER_BPS=25                  # reduce-only IOC exit crossing buffer (bps); must stay below RISK_MAX_BAND_BPS
ENTRY_ORDER_TYPE=LIMIT                    # LIMIT (default, byte-identical) | LIMIT_MAKER (post-only entries; sizer falls back to LIMIT per-intent if the plan-derived price would cross the book)
STARTING_CASH=5000                        # in-memory quote balance the bot tracks (set near the demo account's USDT)

# C1: read-only public derivatives-data feed (funding rate, open interest, mark/index basis) polled
# from the USDT-margined perp market, surfaced to the agentic prompt when fresh. Off by default.
DERIVATIVES_FEED_ENABLED=false
DERIVATIVES_FEED_POLL_MS=60000             # REST poll interval (ms); schema default 60000
# Derivatives-block A/B (owner-authorized measurement start 2026-07-12): the block has been ON
# lane-globally since the 2026-07-10 enable with no control arm, so its effect has never been
# measurable. 30% of decides route to a CONTROL arm that withholds the block entirely (system
# sentence, promptHash's +d1 tag, and the payload's derivatives key together) — a ~70/30
# treatment/control split. 0 (schema default) disables — byte-identical to no A/B.
AGENTIC_DERIVATIVES_AB_PCT=30

# C4: read-only free news/sentiment feed (headlines only, no numeric scores) polled from CryptoPanic,
# surfaced to the agentic prompt when fresh. Off by default. Requires SENTIMENT_FEED_API_KEY — a
# missing key keeps the feed inert even when SENTIMENT_FEED_ENABLED=true.
SENTIMENT_FEED_ENABLED=false
SENTIMENT_FEED_POLL_MS=300000              # REST poll interval (ms); schema default 300000
# CryptoPanic auth_token (secret — never commit a real key; free tier). Leave blank to keep the feed
# inert regardless of SENTIMENT_FEED_ENABLED.
SENTIMENT_FEED_API_KEY=

# ── Risk limits (optional; defaults = the values RiskModule shipped with — override deliberately) ──
RISK_MAX_ORDER_NOTIONAL=100000     # quote-notional cap per order
RISK_MAX_POSITION_PER_SYMBOL=1000  # base-qty cap per symbol position
RISK_MAX_GROSS_EXPOSURE=1000000    # portfolio gross exposure cap (quote)
RISK_MAX_NET_EXPOSURE=1000000      # portfolio net exposure cap (quote)
RISK_MAX_DAILY_LOSS=5000           # daily loss kill threshold (quote)
RISK_MAX_DRAWDOWN_PCT=0.2          # peak-to-trough drawdown kill threshold (fraction)
RISK_MAX_BAND_BPS=100              # max limit-price deviation from ref price (bps)
RISK_STALE_MAX_AGE_MS=5000         # ref-price staleness veto threshold (ms)

# ── LIVE-CAPITAL PROFILE ($1k-$5k) — REFERENCE ONLY, not active (values commented). The block
# above is sized for an account ~100-1000x this range — at $1k-$5k none of it would ever bind, so
# those breakers are decorative at live capital. Do not paste these in verbatim: re-derive against
# the account's ACTUAL equity E and the live SIZER_EQUITY_FRACTION before arming (see
# docs/runbook.md "Before arming at live capital"). Basis: SIZER_EQUITY_FRACTION=0.02 (2% equity
# per entry, scaled by confidence up to 1.0) -> max single entry notional = 0.02E
# (position-sizer.service.ts entryNotional). 5 TRADING_SYMBOLS -> worst-case concurrent gross =
# 5 x 0.02E = 0.10E. Quote ccy = USDT throughout.
#
# RISK_MAX_ORDER_NOTIONAL=40    # E=$1k, P3 fat-finger cap: 2x(0.02E x 1.0) = 0.04E headroom over one max entry
# RISK_MAX_ORDER_NOTIONAL=200   # E=$5k, same formula (0.04E)
#
# RISK_MAX_POSITION_PER_SYMBOL — E1, BASE QTY not notional (limits.ts:10). One flat value applies
#   identically to all 5 TRADING_SYMBOLS whose per-unit prices span ~4-5 orders of magnitude (BTC
#   vs XRP/LINK): a single qty cap cannot bind sensibly on all five. Sizing it for BTC is not a
#   viable alternative: evaluate.ts E1 (182-192) clamps an oversized order down to the qty
#   headroom, then F1 (240-249) hard-rejects BELOW_EXCHANGE_MIN if the clamped qty/notional falls
#   under the venue's minQty/minNotional — a BTC-sized qty cap would clamp every XRP/SOL/LINK order
#   into that reject path and silently break trading on the cheap symbols. Sizing for the cheapest
#   symbol in TRADING_SYMBOLS is therefore the only functional choice, not a preference. CAVEAT
#   (documented, not fixed here — a real per-symbol fix needs the config to become a per-symbol
#   map, out of this task's scope): at that value the cap is necessarily decorative for BTC/ETH —
#   their real per-symbol ceiling is RISK_MAX_ORDER_NOTIONAL / RISK_MAX_GROSS_EXPOSURE /
#   RISK_MAX_NET_EXPOSURE (all quote-denominated), not E1. Formula: qty_cap = 0.04E / price of the
#   cheapest symbol currently in TRADING_SYMBOLS (historically XRP or LINK — verify, do not
#   assume). Worked example below uses an ILLUSTRATIVE placeholder price of $1.00/unit for clean
#   arithmetic ONLY — it is NOT a market quote; substitute the live mark price at arming time.
# RISK_MAX_POSITION_PER_SYMBOL=40    # E=$1k @ illustrative $1.00/unit: 0.04*1000/1.00
# RISK_MAX_POSITION_PER_SYMBOL=200   # E=$5k @ illustrative $1.00/unit: 0.04*5000/1.00
#
# RISK_MAX_GROSS_EXPOSURE=200   # E=$1k, E2 cap: worst-case concurrent 0.10E, x2 headroom for
#   price appreciation + in-flight resize = 0.20E (mid of the 0.15-0.30E sensible band)
# RISK_MAX_GROSS_EXPOSURE=1000  # E=$5k, same formula (0.20E)
#
# RISK_MAX_NET_EXPOSURE=200     # E=$1k, E3 cap: v1 is spot long/flat only (evaluate.ts:46-47 — an
#   increasing order raises gross and net by the same notional, no shorts to offset) so |net| =
#   gross always at this profile; set equal to RISK_MAX_GROSS_EXPOSURE. Revisit this equality if a
#   short/perp lane is ever enabled.
# RISK_MAX_NET_EXPOSURE=1000    # E=$5k, same equality (= RISK_MAX_GROSS_EXPOSURE)
#
# RISK_MAX_DAILY_LOSS=30    # E=$1k, C1 cap: 0.03E — halts the trading day well before drawdown territory
# RISK_MAX_DAILY_LOSS=150   # E=$5k, same formula (0.03E)
#
# RISK_MAX_DRAWDOWN_PCT=0.10   # E=$1k, C2 cap: fraction, equity-independent — 0.10 (tighter than
#   the shipped 0.2 default; live capital should halt sooner than demo-scale capital)
# RISK_MAX_DRAWDOWN_PCT=0.10   # E=$5k, same value — this limit does not scale with E
#
# RISK_MAX_BAND_BPS — P2 cap (bps), a ratio: |limitPrice - refMid|/refMid means the same thing at
#   any account size, so KEEP UNCHANGED at 100 for both E=$1k and E=$5k. Second reason:
#   EXIT_CROSS_BUFFER_BPS=25 (line 116) must stay strictly below it — tightening this without
#   re-checking that headroom risks breaking reduce-only exit crossing.
# RISK_MAX_BAND_BPS=100   # unchanged, both E=$1k and E=$5k

# ── Perp/swap paper adapter (B1; PaperPerpAdapter is not wired into app.module.ts yet) ──
PERP_VENUE_ENABLED=false           # keep off — scaffolding only this pass
PERP_LEVERAGE_CAP=1                # isolated-margin leverage cap
PERP_MMR_FALLBACK=0.005            # conservative fallback maintenance-margin-rate (1-2x BTC/ETH bracket)
PERP_LIQ_BUFFER_PCT=0.20           # B2: required liq-price buffer a perp entry must clear (fraction)

# ── Persistence (optional; paper/demo run fine with no DB) ──
DATABASE_URL=postgres://cryptobot:cryptobot@postgres:5432/cryptobot

# ── Observability ──
# Grafana admin password for docker-compose (defaults to 'grafana' if unset)
GRAFANA_ADMIN_PASSWORD=grafana
