    {
      "id": 90,
      "type": "stat",
      "title": "Promotion readiness",
      "description": "agentic_promotion_ready \u2014 the earned-live verdict from PromotionReadinessService (>=30 closed demo round trips AND positive net-of-cost PnL over >=14 days).",
      "gridPos": {
        "h": 4,
        "w": 2,
        "x": 18,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "NOT READY",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "READY",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ],
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        }
      },
      "options": {
        "colorMode": "background",
        "textMode": "value",
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        }
      },
      "targets": [
        {
          "expr": "agentic_promotion_ready",
          "refId": "A"
        }
      ]
    },
    {
      "id": 154,
      "type": "stat",
      "title": "Playbook net PnL by version (USD)",
      "description": "agentic_version_net_pnl_usd \u2014 realized \u2212 fees per closed round trip, attributed to the playbook version active at entry. THE learning-loop scoreboard: a candidate version earns promotion by beating the champion here.",
      "gridPos": {
        "h": 4,
