{
  "uid": "crypto-bot",
  "title": "crypto-bot",
  "tags": ["crypto-bot"],
  "timezone": "utc",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "type": "query",
        "name": "strategy",
        "label": "Strategy",
        "description": "Per-strategy filter (agentic-1..agentic-5). Sourced from strategy_lifecycle, which emits one series per registered strategy every tick regardless of PnL, so newly-added strategies appear immediately.",
        "datasource": null,
        "query": "label_values(strategy_lifecycle, strategy)",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "sort": 1,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "type": "textbox",
        "name": "price_in_per_mtok",
        "label": "Input $ / 1M tokens",
        "description": "set to your model's pricing (USD per 1M input tokens)",
        "query": "3",
        "current": {
          "text": "3",
          "value": "3"
        }
      },
      {
        "type": "textbox",
        "name": "price_out_per_mtok",
        "label": "Output $ / 1M tokens",
        "description": "set to your model's pricing (USD per 1M output tokens)",
        "query": "15",
        "current": {
          "text": "15",
          "value": "15"
        }
      },
      {
        "type": "textbox",
        "name": "credits_baseline_usd",
        "label": "Credits baseline (USD)",
        "description": "Backlog #56: your Anthropic credit balance, copied from the Anthropic console. Set it TOGETHER with 'Window spend at baseline' (copy the 'API spend (window, DB)' stat at the same moment) — the Credits-left stat subtracts spend accrued since that instant.",
        "query": "0",
        "current": {
          "text": "0",
          "value": "0"
        }
      },
      {
        "type": "textbox",
        "name": "credits_spend_at_baseline_usd",
        "label": "Window spend at baseline (USD)",
        "description": "The value the 'API spend (window, DB)' stat showed at the moment you entered the credits baseline. Anchors the estimate so already-counted spend is not double-subtracted.",
        "query": "0",
        "current": {
          "text": "0",
          "value": "0"
        },
        "hide": true
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Overview",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 142,
      "type": "stat",
      "title": "Total money (equity \u2212 fees \u2212 API cost, USD)",
      "description": "All money right now: equity_usdt minus cumulative fees paid minus cumulative LLM spend (cache-aware: reads 0.1×, 1h-TTL writes 2× the input price). The single bottom-line USD figure.",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 0
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        }
      },
      "targets": [
        {
          "expr": "equity_usdt - scalar(sum(fees_paid_total) or vector(0)) - scalar(sum(agent_tokens_total{kind=\"input\"}) or vector(0)) / 1e6 * ${price_in_per_mtok} - scalar(sum(agent_tokens_total{kind=\"output\"}) or vector(0)) / 1e6 * ${price_out_per_mtok} - scalar(sum(agent_tokens_total{kind=\"cache_read\"}) or vector(0)) / 1e6 * (0.1 * ${price_in_per_mtok}) - scalar(sum(agent_tokens_total{kind=\"cache_creation\"}) or vector(0)) / 1e6 * (2 * ${price_in_per_mtok})",
          "refId": "A"
        }
      ]
    },
    {
      "id": 130,
      "type": "stat",
      "title": "Net-of-cost PnL (evidence, USD)",
      "description": "agentic_promotion_net_pnl_usd \u2014 realized PnL minus fees minus LLM spend over the earned-live promotion evidence window (PromotionReadinessService; sampled every 5m). THE headline number: the bot is only profitable if this is positive.",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 0
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        }
      },
      "targets": [
        {
          "expr": "agentic_promotion_net_pnl_usd",
          "refId": "A"
        }
      ]
    },
    {
      "id": 100,
      "type": "stat",
      "title": "Return since inception (%)",
      "description": "(equity \u2212 starting cash) / starting cash \u2014 total return since the account was seeded.",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 0
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        }
      },
      "targets": [
        {
          "expr": "(equity_usdt - starting_cash_usdt) / starting_cash_usdt",
          "refId": "A"
        }
      ]
    },
    {
      "id": 101,
      "type": "stat",
      "title": "Day return (%)",
      "description": "Day PnL as a % of start-of-day equity (equity \u2212 dayPnL).",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 0
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        }
      },
      "targets": [
        {
          "expr": "day_pnl_usdt / (equity_usdt - day_pnl_usdt)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 103,
      "type": "stat",
      "title": "Realized PnL \u2014 round trips (USDT)",
      "description": "Cumulative realized PnL summed over completed round trips (trade_pnl_usdt histogram _sum, net of fees).",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 0
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        }
      },
      "targets": [
        {
          "expr": "sum(trade_pnl_usdt_sum)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 102,
      "type": "stat",
      "title": "Unrealized PnL (USDT)",
      "description": "Mark-to-market PnL on open positions: \u03a3 signedQty\u00d7(mark \u2212 avgEntry).",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 0
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        }
      },
      "targets": [
        {
          "expr": "unrealized_pnl_usdt",
          "refId": "A"
        }
      ]
    },
    {
      "id": 119,
      "type": "timeseries",
      "title": "Equity & peak (USDT)",
      "description": "Account equity = cash + \u03a3 position\u00d7mark, with the persisted peak high-water mark. Both survive restarts (DB recovery).",
      "gridPos": {
        "h": 8,
        "w": 16,
        "x": 0,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 8
          }
        }
      },
      "targets": [
        {
          "expr": "equity_usdt",
          "refId": "A",
          "legendFormat": "equity"
        },
        {
          "expr": "peak_equity_usdt",
          "refId": "B",
          "legendFormat": "peak"
        }
      ]
    },
    {
      "id": 117,
      "type": "stat",
      "title": "API cost (cumulative USD)",
      "description": "Cumulative LLM spend since process start (token totals \u00d7 the per-1M price template vars), cache-aware: reads at 0.1\u00d7 and 1h-TTL writes at 2\u00d7 the input price. Flat template-var pricing \u2014 the per-model canonical figure is agentic_promotion_llm_cost_usd. Resets on restart.",
      "gridPos": {
        "h": 2,
        "w": 4,
        "x": 16,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        }
      },
      "targets": [
        {
          "expr": "sum(agent_tokens_total{kind=\"input\"}) / 1e6 * ${price_in_per_mtok} + sum(agent_tokens_total{kind=\"output\"}) / 1e6 * ${price_out_per_mtok} + (sum(agent_tokens_total{kind=\"cache_read\"}) or vector(0)) / 1e6 * (0.1 * ${price_in_per_mtok}) + (sum(agent_tokens_total{kind=\"cache_creation\"}) or vector(0)) / 1e6 * (2 * ${price_in_per_mtok})",
          "refId": "A"
        }
      ]
    },
    {
      "id": 156,
      "type": "stat",
      "title": "Credits left (est., USD)",
      "description": "Backlog #56: estimated Anthropic credits remaining = credits_baseline_usd \u2212 (window spend since the baseline was entered). Update recipe: open the Anthropic console, copy the balance into the 'Credits baseline' variable and this dashboard's 'API spend (window, DB)' value into 'Window spend at baseline' at the same moment. ESTIMATE ONLY \u2014 blind to out-of-band spend (owner sessions, offline evals) and to the perp lane's own Prometheus; reads 0 until the baseline vars are set. Exact balance needs the Anthropic Admin API (separate admin key \u2014 deliberately not wired, rule 7).",
      "gridPos": {
        "h": 2,
        "w": 2,
        "x": 16,
        "y": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 5
              },
              {
                "color": "green",
                "value": 20
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        }
      },
      "targets": [
        {
          "expr": "${credits_baseline_usd} - (agentic_promotion_llm_cost_usd - ${credits_spend_at_baseline_usd})",
          "refId": "A"
        }
      ]
    },
    {
      "id": 157,
      "type": "stat",
      "title": "API spend (window, DB)",
      "description": "agentic_promotion_llm_cost_usd \u2014 the DB-backed, per-model, cache-aware spend over the evidence window (survives restarts, unlike the cumulative stat above, which resets each boot). Also the number to copy into 'Window spend at baseline' when setting the credits baseline.",
      "gridPos": {
        "h": 2,
        "w": 2,
        "x": 18,
        "y": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        }
      },
      "targets": [
        {
          "expr": "agentic_promotion_llm_cost_usd",
          "refId": "A"
        }
      ]
    },
    {
      "id": 105,
      "type": "stat",
      "title": "Win rate",
      "description": "Winning round trips \u00f7 total round trips (round-trip PnL > 0 is a win).",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        }
      },
      "targets": [
        {
          "expr": "sum(round_trips_total{result=\"win\"}) / clamp_min(sum(round_trips_total), 1)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 91,
      "type": "stat",
      "title": "Round trips (evidence)",
      "description": "agentic_promotion_round_trips \u2014 closed demo round trips counted toward the >=30 promotion threshold.",
      "gridPos": {
        "h": 4,
        "w": 2,
        "x": 16,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 30
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        }
      },
      "targets": [
        {
          "expr": "agentic_promotion_round_trips",
          "refId": "A"
        }
      ]
