{
  "uid": "crypto-bot-exec",
  "title": "crypto-bot — Execution quality",
  "tags": ["crypto-bot"],
  "timezone": "utc",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Order outcomes (per s, 5m rate)",
      "description": "Every ExecutionGate.submit() result by outcome (SUBMITTED / REJECTED / UNKNOWN).",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "stacking": { "mode": "normal" } } } },
      "targets": [{ "expr": "sum by (outcome) (rate(orders_total[5m]))", "refId": "A", "legendFormat": "{{ outcome }}" }]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Rejection taxonomy (per s, 5m rate)",
      "description": "Full §8 taxonomy: orders_rejected_total by stage (oms = our pre-network gate, exchange = venue) plus risk_rejections_total (risk-engine vetoes; sibling metric because eslint-boundaries forbids modules/risk importing the gate's counter).",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "bars", "stacking": { "mode": "normal" } } } },
      "targets": [
        { "expr": "sum by (stage, code) (rate(orders_rejected_total[5m]))", "refId": "A", "legendFormat": "{{ stage }}:{{ code }}" },
        { "expr": "sum by (code) (rate(risk_rejections_total[5m]))", "refId": "B", "legendFormat": "risk:{{ code }}" }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Fill rate by type/TIF (5m)",
      "description": "Σ filled qty / Σ submitted qty over the window, per order type and time-in-force. Limit fill rate is strategy-meaningful; market should be ~1.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 } },
      "targets": [
        {
          "expr": "sum by (type, tif) (rate(orders_filled_qty_total[5m])) / clamp_min(sum by (type, tif) (rate(orders_submitted_qty_total[5m])), 0.0001)",
          "refId": "A",
          "legendFormat": "{{ type }}/{{ tif }}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Submit→ack latency (s)",
      "description": "order_submit_latency_seconds quantiles by order type (intent submission to venue ack).",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        { "expr": "histogram_quantile(0.5, sum by (le, type) (rate(order_submit_latency_seconds_bucket[5m])))", "refId": "A", "legendFormat": "p50 {{ type }}" },
        { "expr": "histogram_quantile(0.95, sum by (le, type) (rate(order_submit_latency_seconds_bucket[5m])))", "refId": "B", "legendFormat": "p95 {{ type }}" },
        { "expr": "histogram_quantile(0.99, sum by (le, type) (rate(order_submit_latency_seconds_bucket[5m])))", "refId": "C", "legendFormat": "p99 {{ type }}" }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Decision slippage (bps, signed; + = adverse)",
      "description": "order_slippage_decision_bps — execution price vs the signal's reference price. Positive = adverse for both sides. p50/p90 over 5m.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "none" } },
      "targets": [
        { "expr": "histogram_quantile(0.5, sum by (le, symbol) (rate(order_slippage_decision_bps_bucket[5m])))", "refId": "A", "legendFormat": "p50 {{ symbol }}" },
        { "expr": "histogram_quantile(0.9, sum by (le, symbol) (rate(order_slippage_decision_bps_bucket[5m])))", "refId": "B", "legendFormat": "p90 {{ symbol }}" }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Fully-filled order ratio (5m)",
      "description": "orders_fully_filled_total / orders_submitted_total — share of submissions that reached FILLED.",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "percentunit" } },
      "targets": [
        { "expr": "sum(rate(orders_fully_filled_total[5m])) / clamp_min(sum(rate(orders_submitted_total[5m])), 0.0001)", "refId": "A" }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Open orders & in-flight intents",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 16 },
      "targets": [
        { "expr": "open_orders", "refId": "A", "legendFormat": "open orders" },
        { "expr": "in_flight_intents", "refId": "B", "legendFormat": "in-flight" }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Fills & submissions (per s, 5m rate)",
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 24 },
      "targets": [
        { "expr": "rate(fills_total[5m])", "refId": "A", "legendFormat": "fills/s" },
        { "expr": "sum(rate(orders_submitted_total[5m]))", "refId": "B", "legendFormat": "submitted/s" }
      ]
    }
  ]
}
