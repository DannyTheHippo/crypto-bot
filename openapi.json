                        }
                      },
                      "additionalProperties": {
                        "type": "object",
                        "required": [
                          "status"
                        ],
                        "properties": {
                          "status": {
                            "type": "string"
                          }
                        },
                        "additionalProperties": true
                      }
                    }
                  }
                },
                "examples": {
                  "example": {
                    "summary": "Readiness check passing (paper mode, DB-less)",
                    "value": {
                      "status": "ok",
                      "info": {
                        "event_loop_delay": {
                          "status": "up"
                        },
                        "config": {
                          "status": "up",
                          "effectiveMode": "paper",
                          "killSwitchState": "RUNNING"
                        }
                      },
                      "error": {},
                      "details": {
                        "event_loop_delay": {
                          "status": "up"
                        },
                        "config": {
                          "status": "up",
                          "effectiveMode": "paper",
                          "killSwitchState": "RUNNING"
