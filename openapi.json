    "/metrics": {
      "get": {
        "operationId": "PrometheusController_index",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "tags": [
          "Prometheus"
        ]
      }
    },
    "/mode/arm/request": {
      "post": {
        "operationId": "ArmingController_request",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ArmRequestRequestDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Arm request refused (precondition not met).\n\nArming challenge issued.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ArmResultResponseDto"
                },
                "examples": {
                  "example": {
                    "summary": "Challenge issued",
                    "value": {
                      "ok": true,
                      "challengeId": "3f9d2e1a-6b4c-4e2a-9c1a-0f2e1d3c4b5a"
                    }
                  }
                }
              }
            }
          }
        },
        "tags": [
          "Arming"
        ]
      }
    },
    "/mode/arm/confirm": {
      "post": {
        "operationId": "ArmingController_confirm",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ArmConfirmRequestDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Arm confirmation refused.\n\nArming confirmed; mode transitions to ARMED.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ArmResultResponseDto"
                },
                "examples": {
                  "example": {
                    "summary": "Armed",
                    "value": {
                      "ok": true
                    }
                  }
                }
              }
            }
          }
        },
        "tags": [
          "Arming"
        ]
      }
    },
    "/mode/disarm": {
      "post": {
        "operationId": "ArmingController_disarm",
        "parameters": [],
        "responses": {
          "201": {
            "description": "Disarm recorded; mode reverts to the resolved effective mode."
          }
        },
        "tags": [
          "Arming"
        ]
      }
    }
  },
  "info": {
    "title": "crypto-bot API",
    "description": "crypto-bot arming/mode-control API specification",
    "version": "0.0.1",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "ArmRequestRequestDto": {
        "type": "object",
        "properties": {}
      },
      "ArmResultResponseDto": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean",
            "example": true,
            "description": "Whether the arm step succeeded."
          },
          "challengeId": {
            "type": "string",
            "example": "3f9d2e1a-6b4c-4e2a-9c1a-0f2e1d3c4b5a",
            "description": "Challenge id issued on a successful REQUEST step."
          },
          "reason": {
            "type": "string",
            "example": "HMAC_MISMATCH",
            "enum": [
              "TTL_EXPIRED",
              "REPLAY",
              "HMAC_MISMATCH",
              "PRECONDITION"
            ],
            "description": "Failure reason, present when ok is false."
          }
        },
        "required": [
          "ok"
        ]
      },
      "ArmConfirmRequestDto": {
        "type": "object",
        "properties": {}
      }
    }
  }
}
