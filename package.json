{
  "name": "crypto-bot",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "--- RUN ---": "--------------------------------",
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "--- DB MIGRATIONS ---": "--------------------------------",
    "migrate": "drizzle-kit migrate",
    "--- PLAYBOOK OPS ---": "--------------------------------",
    "playbook:promote": "node scripts/playbook-promote.mjs",
    "playbook:candidate": "node --env-file-if-exists=.env.app scripts/playbook-candidate.mjs",
    "--- MODE CONTROL OPS ---": "--------------------------------",
    "arm": "node scripts/arm-ceremony.mjs",
    "loop:sweep": "node scripts/loop-sweep.mjs",
    "loop:authoring": "node --env-file-if-exists=.env.app scripts/loop-authoring.mjs",
    "loop:experiment": "node scripts/log-eval-experiment.mjs",
    "loop:lock": "node scripts/loop-pass-lock.mjs",
    "loop:unlock": "node scripts/loop-pass-lock.mjs release",
    "--- CHECKS ---": "--------------------------------",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.eslint.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:md": "markdownlint-cli2",
    "lint:md:fix": "markdownlint-cli2 --fix",
    "checks": "pnpm format:check && pnpm lint:md && pnpm lint && pnpm typecheck && pnpm test",
    "--- TESTS ---": "--------------------------------",
    "test": "vitest run test/features test/domain test/ports test/livegate",
    "test:livegate": "vitest run test/livegate",
    "test:paper": "vitest run --passWithNoTests test/paper",
    "test:cov": "vitest run --coverage test/features test/domain test/ports test/livegate",
    "test:db": "vitest run --passWithNoTests --no-file-parallelism test/db",
    "test:testnet": "vitest run --passWithNoTests test/testnet",
    "--- RESEARCH ---": "--------------------------------",
    "eval:agentic": "vitest run test/eval",
    "eval:candidates": "EVAL_CANDIDATES=1 vitest run test/eval/agentic/candidate-model-eval.spec.ts",
    "eval:trade-models": "EVAL_TRADE_MODELS=1 vitest run test/eval/agentic/trade-model-eval.spec.ts",
    "eval:playbook": "vitest run test/eval/agentic/recorded-payload-live-compare.spec.ts",
    "eval:playbook-space": "PLAYBOOK_SPACE=1 vitest run test/eval/agentic/playbook-space-replay.spec.ts",
    "eval:degradation": "vitest run test/eval/agentic/payload-degradation-live.spec.ts",
    "backtest": "vitest run test/backtest",
    "backtest:agentic": "node scripts/backtest-agentic.mjs",
    "fetch:edge-tournament": "node scripts/fetch-edge-tournament-data.mjs --smoke",
    "fetch:edge-tournament:full": "node scripts/fetch-edge-tournament-data.mjs --full",
    "run:edge-tournament": "EDGE_TOURNAMENT_RUN=1 vitest run test/backtest/edge-tournament/run-once.spec.ts",
    "replay:agentic": "node scripts/replay-agentic.mjs",
    "openapi:write": "OPENAPI_WRITE=1 vitest run test/features/common/config/openapi-snapshot.spec.ts",
    "--- HOOKS ---": "--------------------------------",
    "prepare": "husky"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.26",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.26",
    "@nestjs/platform-express": "^11.1.26",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.5",
    "@nestjs/terminus": "^11.1.1",
    "@willsoto/nestjs-prometheus": "^6.1.0",
    "ccxt": "4.5.58",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "decimal.js": "^10.6.0",
    "drizzle-orm": "0.45.2",
    "nestjs-pino": "^4.6.1",
    "pg": "8.21.0",
    "pino": "^9.7.0",
    "pino-http": "^10.4.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.7",
    "@nestjs/schematics": "^11.0.5",
    "@nestjs/testing": "^11.1.26",
    "@swc/core": "^1.11.29",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.2",
    "@types/pg": "^8.20.0",
    "@types/superagent": "^8.1.10",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.8",
    "drizzle-kit": "0.31.10",
    "eslint": "^9.28.0",
    "eslint-plugin-boundaries": "^6.0.2",
    "fast-check": "^4.8.0",
    "husky": "^9.1.7",
    "markdownlint-cli2": "^0.23.0",
    "prettier": "^3.5.3",
    "supertest": "^7.1.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.33.1",
    "unplugin-swc": "^1.5.2",
    "vitest": "^4.1.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "esbuild"
    ]
  }
}
